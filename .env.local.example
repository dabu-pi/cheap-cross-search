# ============================================================
# 安買い横断サーチ 環境変数テンプレート
# このファイルを .env.local にコピーして実値を設定してください
# .env.local は .gitignore で除外済み（コミット禁止）
# ============================================================

# ──────────────────────────────────────
# Supabase（必須: Phase 3 認証から使用）
# ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # サーバーサイド専用・公開禁止

# ──────────────────────────────────────
# 楽天市場（商品検索API version 2026-04-01）
# 取得先: 楽天 Developers / Rakuten Web Service（https://webservice.rakuten.co.jp/）
# アプリ登録で「アプリケーションID」「アクセスキー」「アフィリエイトID」を確認
# 2026-04-01 仕様では applicationId と accessKey の両方が必須
# ──────────────────────────────────────
# RAKUTEN_APP_ID=your-rakuten-application-id       # アプリケーションID（必須）
# RAKUTEN_ACCESS_KEY=your-rakuten-access-key       # アクセスキー（必須・サーバー専用）
# RAKUTEN_AFFILIATE_ID=your-rakuten-affiliate-id   # アフィリエイトID（任意）

# ──────────────────────────────────────
# Yahoo!ショッピング（Phase 22: Yahoo!デベロッパーAPI）
# 取得先: https://developer.yahoo.co.jp/webapi/shopping/
# Yahoo! JAPAN IDでアプリ登録後、即日発行
# ──────────────────────────────────────
# YAHOO_APP_ID=your-yahoo-app-id

# ──────────────────────────────────────
# Amazon（Phase 5: PA-API / Creators API）
# ──────────────────────────────────────
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_ASSOCIATE_TAG=
# AMAZON_REGION=ap-northeast-1

# ──────────────────────────────────────
# AliExpress（Phase 5: Affiliate API）
# ──────────────────────────────────────
# ALIEXPRESS_APP_KEY=
# ALIEXPRESS_APP_SECRET=
# ALIEXPRESS_TRACKING_ID=

# ──────────────────────────────────────
# SHEIN（Phase 5: Developer Platform）
# ──────────────────────────────────────
# SHEIN_APP_KEY=
# SHEIN_APP_SECRET=

# ──────────────────────────────────────
# Temu（Phase 5: Partner Platform）
# ──────────────────────────────────────
# TEMU_APP_KEY=
# TEMU_APP_SECRET=

# ──────────────────────────────────────
# 外部検索API（Phase 5: TKAPI 等）
# ──────────────────────────────────────
# EXTERNAL_SEARCH_API_KEY=
# EXTERNAL_SEARCH_API_BASE_URL=

# ──────────────────────────────────────
# 管理者設定（Phase 4: 管理画面）
# ──────────────────────────────────────
# ADMIN_EMAILS=admin@example.com,admin2@example.com
